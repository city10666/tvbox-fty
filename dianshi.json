name: 自动同步 dianshi.json

on:
  schedule:
    - cron: '0 0 * * *'  # 每天 UTC 时间 00:00 运行（北京时间 08:00）
  workflow_dispatch:     # 允许手动触发
  push:
    branches: [ main ]

jobs:
  sync-dianshi:
    runs-on: ubuntu-latest
    
    steps:
    - name: 检出代码
      uses: actions/checkout@v4
      with:
        token: ${{ secrets.GITHUB_TOKEN }}
        fetch-depth: 0

    - name: 设置 Git 配置
      run: |
        git config --local user.email "action@github.com"
        git config --local user.name "GitHub Action"

    - name: 下载源文件和本地文件
      run: |
        # 下载源仓库文件
        curl -s -o source.json "https://raw.githubusercontent.com/qist/tvbox/master/dianshi.json"
        # 复制本地文件作为模板
        cp dianshi.json local_template.json

    - name: 处理 JSON 文件（保持你的格式和顺序）
      run: |
        # 安装 Node.js 处理脚本
        cat > process_json.js << 'EOF'
        const fs = require('fs');
        
        // 读取源文件和本地模板
        const sourceData = JSON.parse(fs.readFileSync('source.json', 'utf8'));
        const localTemplate = JSON.parse(fs.readFileSync('local_template.json', 'utf8'));
        
        // 定义你希望优先的 sites 键值
        const prioritySitesKeys = [
          "drpy_js_360影视",
          "drpy_js_百忙无果",
          "drpy_js_腾云驾雾",
          "drpy_js_奇珍异兽",
          "drpy_js_菜狗",
          "drpy_js_优酷"
        ];
        
        // 创建结果对象，保持本地模板的结构
        const result = { ...localTemplate };
        
        // 处理 sites 数组
        result.sites = [];
        
        // 1. 先添加你指定的优先级 sites
        prioritySitesKeys.forEach(key => {
          const foundInSource = sourceData.sites.find(s => s.key === key);
          if (foundInSource) result.sites.push(foundInSource);
        });
        
        // 2. 然后添加本地模板中的其他 sites
        localTemplate.sites.forEach(site => {
          if (!prioritySitesKeys.includes(site.key)) {
            result.sites.push(site);
          }
        });
        
        // 3. 最后添加源数据中的新 sites（不在本地模板中的）
        sourceData.sites.forEach(site => {
          if (!prioritySitesKeys.includes(site.key) && 
              !localTemplate.sites.some(s => s.key === site.key)) {
            result.sites.push(site);
          }
        });
        
        // 更新其他字段（保持本地值优先）
        const fieldsToUpdate = ['spider', 'lives', 'wallpaper', 'parses', 'flags', 'doh', 'rules', 'ads'];
        fieldsToUpdate.forEach(field => {
          if (sourceData[field] !== undefined && localTemplate[field] === undefined) {
            result[field] = sourceData[field];
          }
        });
        
        // 写入处理后的文件，保持格式
        fs.writeFileSync('dianshi.json', JSON.stringify(result, null, 2));
        EOF
        
        node process_json.js

    - name: 检查文件变化并提交
      run: |
        git add dianshi.json
        if git diff --staged --quiet; then
          echo "🔄 没有检测到变化"
        else
          git commit -m "🔄 自动同步 dianshi.json - $(date +'%Y-%m-%d %H:%M:%S')"
          git push
          echo "✅ 更改已提交"
        fi
