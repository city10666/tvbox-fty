name: Sync TVBox Config

on:
  schedule:
    - cron: '0 0 * * *'  # 每天UTC时间0点运行(北京时间8点)
  workflow_dispatch:     # 允许手动触发

jobs:
  sync-config:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v4
        with:
          python-version: '3.10'

      - name: Install dependencies
        run: pip install requests

      - name: Run sync script
        run: |
          cat << 'EOF' > sync.py
          import json
          import requests
          
          def sync_config():
              # 源和目标URL
              source_url = "https://raw.githubusercontent.com/qist/tvbox/master/dianshi.json"
              
              # 指定要前置的项目
              priority_items = [
                  {"key": "drpy_js_360影视", "name": "官源 | 360[js]", "type": 3, "api": "./lib/drpy2.min.js", "ext": "./js/360影视.js"},
                  {"key": "drpy_js_百忙无果", "name": "官源 | 芒果[js]", "type": 3, "api": "./lib/drpy2.min.js", "ext": "./js/百忙无果.js"},
                  {"key": "drpy_js_腾云驾雾", "name": "官源 | 腾讯[js]", "type": 3, "api": "./lib/drpy2.min.js", "ext": "./js/腾云驾雾.js"},
                  {"key": "drpy_js_奇珍异兽", "name": "官源 | 爱奇艺[js]", "type": 3, "api": "./lib/drpy2.min.js", "ext": "./js/奇珍异兽.js"},
                  {"key": "drpy_js_菜狗", "name": "官源 | 搜狗[js]", "type": 3, "api": "./lib/drpy2.min.js", "ext": "./js/菜狗.js"},
                  {"key": "drpy_js_优酷", "name": "官源 | 优酷[js]", "type": 3, "api": "./lib/drpy2.min.js", "ext": "./js/优酷.js"}
              ]
              
              # 获取源数据
              response = requests.get(source_url)
              source_data = response.json()
              
              # 创建新列表，先添加优先级项目
              new_data = priority_items.copy()
              
              # 添加源数据中不在优先级列表中的项目
              for item in source_data:
                  if not any(pi["key"] == item["key"] for pi in priority_items):
                      new_data.append(item)
              
              # 保存到文件
              with open("aiyouteng.json", "w", encoding="utf-8") as f:
                  json.dump(new_data, f, ensure_ascii=False, indent=2)
          
          if __name__ == "__main__":
              sync_config()
          EOF
          
          python sync.py

      - name: Commit and push changes
        run: |
          git config --global user.name "GitHub Actions"
          git config --global user.email "actions@github.com"
          git add aiyouteng.json
          git diff --quiet && git diff --staged --quiet || (git commit -m "Auto-sync TVBox config" && git push)
